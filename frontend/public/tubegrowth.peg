  <circle cx="50" cy="128" r="4" fill="#1f5d95"/>
  <circle cx="206" cy="128" r="4" fill="#1f5d95"/>
  <g fill="none" stroke="#1f5d95" stroke-linecap="round" stroke-linejoin="round">
